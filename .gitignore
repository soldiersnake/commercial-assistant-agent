datos/serv_*.log

# ── Carpeta de entrada (ficheros reales de clientes) ───────
entrada/*.xls
entrada/*.xlsx
entrada/*.csv
entrada/procesados/

# ── Vistas generadas (regenerables, con datos personales) ────
excel/

# ── Sistema / editor ─────────────────────────────────────
Thumbs.db
desktop.ini
*.tmp
tests/_*.tmp.js
datos/ventas.json

